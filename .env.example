# Collection root, no trailing slash.
#   cloud   -> https://dev.azure.com/my-org
#   on-prem -> https://tfs.internal/tfs/DefaultCollection
ADO_BASE_URL=https://dev.azure.com/my-org

# Personal Access Token. Scopes: Work Items (Read & Write), Project and Team
# (Read), Identity (Read) for avatars. Write is needed only to post comments.
ADO_PAT=

# Azure DevOps Server trails the cloud; drop to 6.0 if 7.1 returns 404s.
ADO_API_VERSION=7.1

# Gate in front of the whole app. Leaving this empty makes the app public to
# anyone who can reach it.
APP_PASSWORD=
SESSION_SECRET=

PORT=8787
HOST=127.0.0.1

# Serve bundled fixtures instead of calling ADO, so the UI runs with no PAT.
DEMO_MODE=false
CACHE_TTL_SECONDS=60

# ---- Claude analysis ----

# The CLI runs on this machine, with your login and your skills.
AI_ENABLED=true
CLAUDE_BIN=claude
AI_SKILL=ado-ticket-analyze

# How the skill is invoked. {skill} and {file} are substituted; {file} is a
# JSON dump of the work item and its comments.
AI_PROMPT_TEMPLATE=/{skill} {file}

# Empty uses the CLI default.
AI_MODEL=

# Where the ticket JSON is written and the CLI runs. Empty uses a temp dir.
AI_WORKSPACE_DIR=

AI_TIMEOUT_MS=300000
AI_MAX_CONCURRENT=1
AI_PERMISSION_MODE=dontAsk
AI_ALLOWED_TOOLS=Read,Grep,Glob
